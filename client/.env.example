# Local dev (Vite proxies /api to localhost:5000)
# Leave VITE_API_URL unset or use empty for same-origin /api

# Production on Vercel — set in Vercel dashboard:
# VITE_API_URL=          (empty / unset — same-origin /api via vercel.json rewrite)
# VITE_SOCKET_URL=http://13.232.109.22
# VITE_SOCKET_PATH=/skill-api/socket.io/

# Optional: custom ICE servers for WebRTC (JSON array)
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]