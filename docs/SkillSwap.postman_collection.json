{
	"info": {
		"_postman_id": "skillswap-api-collection",
		"name": "SkillSwap API",
		"description": "Complete API collection for SkillSwap platform",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"john_doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "register"]
						}
					}
				},
				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "Get Current User",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "me"]
						}
					}
				},
				{
					"name": "Update Profile",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"bio\": \"Passionate developer and teacher\",\n  \"location\": {\n    \"city\": \"New York\",\n    \"country\": \"USA\"\n  },\n  \"availability\": [\"weekday_evening\", \"weekend_morning\"]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/profile",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "profile"]
						}
					}
				},
				{
					"name": "Update Skills",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"skillsOffered\": [\"javascript\", \"react\", \"node.js\"],\n  \"skillsSought\": [\"python\", \"machine learning\"]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/skills",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "skills"]
						}
					}
				}
			]
		},
		{
			"name": "Matches",
			"item": [
				{
					"name": "Get Potential Matches",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/matches/potential",
							"host": ["{{baseUrl}}"],
							"path": ["api", "matches", "potential"]
						}
					}
				},
				{
					"name": "Get Potential Matches with Filters",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/matches/potential?city=New York&country=USA&minRating=4&availability=weekday_evening",
							"host": ["{{baseUrl}}"],
							"path": ["api", "matches", "potential"],
							"query": [
								{
									"key": "city",
									"value": "New York"
								},
								{
									"key": "country",
									"value": "USA"
								},
								{
									"key": "minRating",
									"value": "4"
								},
								{
									"key": "availability",
									"value": "weekday_evening"
								}
							]
						}
					}
				},
				{
					"name": "Send Match Request",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"recipientId\": \"USER_ID_HERE\",\n  \"message\": \"Hi! I'd love to exchange skills with you.\",\n  \"matchedSkills\": [\"javascript\", \"react\"]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/matches/request",
							"host": ["{{baseUrl}}"],
							"path": ["api", "matches", "request"]
						}
					}
				},
				{
					"name": "Get Received Requests",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/matches/received",
							"host": ["{{baseUrl}}"],
							"path": ["api", "matches", "received"]
						}
					}
				},
				{
					"name": "Get Sent Requests",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/matches/sent",
							"host": ["{{baseUrl}}"],
							"path": ["api", "matches", "sent"]
						}
					}
				},
				{
					"name": "Respond to Match Request",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"accepted\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/matches/:matchId/respond",
							"host": ["{{baseUrl}}"],
							"path": ["api", "matches", ":matchId", "respond"],
							"variable": [
								{
									"key": "matchId",
									"value": "MATCH_ID_HERE"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "Chat",
			"item": [
				{
					"name": "Get Chat Rooms",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/chat/rooms",
							"host": ["{{baseUrl}}"],
							"path": ["api", "chat", "rooms"]
						}
					}
				},
				{
					"name": "Get Messages",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/chat/rooms/:roomId/messages",
							"host": ["{{baseUrl}}"],
							"path": ["api", "chat", "rooms", ":roomId", "messages"],
							"variable": [
								{
									"key": "roomId",
									"value": "ROOM_ID_HERE"
								}
							]
						}
					}
				},
				{
					"name": "Send Message",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"content\": \"Hello! How are you?\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/chat/rooms/:roomId/messages",
							"host": ["{{baseUrl}}"],
							"path": ["api", "chat", "rooms", ":roomId", "messages"],
							"variable": [
								{
									"key": "roomId",
									"value": "ROOM_ID_HERE"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "Notifications",
			"item": [
				{
					"name": "Get Notifications",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/notifications",
							"host": ["{{baseUrl}}"],
							"path": ["api", "notifications"]
						}
					}
				},
				{
					"name": "Mark Notification as Read",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/notifications/:notificationId/read",
							"host": ["{{baseUrl}}"],
							"path": ["api", "notifications", ":notificationId", "read"],
							"variable": [
								{
									"key": "notificationId",
									"value": "NOTIFICATION_ID_HERE"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "Reviews",
			"item": [
				{
					"name": "Create Review",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"revieweeId\": \"USER_ID_HERE\",\n  \"rating\": 5,\n  \"comment\": \"Great teacher! Very patient and knowledgeable.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/reviews",
							"host": ["{{baseUrl}}"],
							"path": ["api", "reviews"]
						}
					}
				},
				{
					"name": "Get User Reviews",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/reviews/user/:userId",
							"host": ["{{baseUrl}}"],
							"path": ["api", "reviews", "user", ":userId"],
							"variable": [
								{
									"key": "userId",
									"value": "USER_ID_HERE"
								}
							]
						}
					}
				}
			]
		}
	]
}
