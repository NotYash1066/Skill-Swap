# Root level
node_modules/
npm-debug.log
.git/
.gitignore

# Environment & secrets (never copy into image)
.env
.env.local
.env.*.local
server/.env
server/.env.local
*.pem
*.key
secrets/

# Documentation & heavy non-runtime folders
*.md
.vscode/
.idea/
.omx/
.stitch/
conductor/
docs/

# Client build artifacts (we build fresh in Dockerfile)
client/node_modules/
client/dist/
client/build/

# Server
server/node_modules/
server/uploads/
server/.env*

# OS junk
.DS_Store
Thumbs.db

# Logs & temp
*.log
*.tmp

# Deployment local overrides
.railway/
railway.env
