# SkillSwap - Production Environment Template
# ============================================
# Copy relevant values into your platform (Railway, Render, etc.) dashboard.
# Generate strong secrets with: openssl rand -base64 48

# Server
PORT=5000
NODE_ENV=production

# Frontend URL (for CORS + links in emails)
CLIENT_URL=https://your-skillswap-domain.com

# Database - MongoDB Atlas (recommended for free tier)
MONGO_URI=mongodb+srv://username:CHANGE_ME_PASSWORD@cluster0.xxxxx.mongodb.net/SkillSwapDB?retryWrites=true&w=majority

# Redis (Railway addon or Upstash or docker-compose)
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Authentication (MUST be different from each other)
JWT_SECRET=CHANGE_ME_TO_RANDOM_32_PLUS_CHARS_1
REFRESH_TOKEN_SECRET=CHANGE_ME_TO_DIFFERENT_RANDOM_32_PLUS_CHARS_2

# Email (optional - leave as-is if you don't need password reset / notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password
FROM_NAME=SkillSwap
FROM_EMAIL=noreply@yourdomain.com

# WebRTC / TURN (strongly recommended for reliable video calls)
# Option 1: Twilio Network Traversal Service (best free/paid option)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Option 2: Provide static ICE servers as JSON (fallback)
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-turn.example.com:3478","username":"user","credential":"pass"}]
