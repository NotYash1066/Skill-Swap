# ============================================
# SkillSwap Production Environment
# ============================================
# Generate secure secrets with:
#   openssl rand -base64 48
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Frontend URL (for CORS and email links)
CLIENT_URL=https://your-domain.com

# Database
MONGO_URI=mongodb://mongodb:27017/SkillSwapDB

# Redis
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Authentication (REQUIRED - generate strong secrets!)
# Generate: openssl rand -base64 48
JWT_SECRET=replace_with_generated_secret_min_32_chars
REFRESH_TOKEN_SECRET=replace_with_different_generated_secret_min_32_chars

# Email Configuration (optional for demo)
# If email features aren't needed, leave as-is; 
# the app will still work but email features will be disabled.

# Email (optional - Nodemailer Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_specific_password
FROM_NAME=SkillSwap
FROM_EMAIL=noreply@skillswap.com

# Legacy email config (for backward compatibility)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# Logging
LOG_LEVEL=info

# WebRTC / TURN Server Configuration
# Option 1 (recommended for production): Twilio Network Traversal Service
#   Sign up at https://www.twilio.com/console, then set:
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
#   The backend will auto-fetch ephemeral TURN credentials via /api/ice-servers
#
# Option 2 (fallback): Provide ICE servers as JSON array
#   Overrides Twilio if VITE_ICE_SERVERS is also set on the frontend.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-turn-server.com:3478","username":"user","credential":"pass"}]
