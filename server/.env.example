# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/SkillSwapDB

# Security
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters_long
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_minimum_32_characters

# Client
CLIENT_URL=http://localhost:5173

# Email Service (Gmail)
EMAIL_SERVICE=gmail
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
FROM_NAME=SkillSwap
FROM_EMAIL=noreply@skillswap.com

# Legacy email config (for backward compatibility)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# Redis (optional - for caching)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
